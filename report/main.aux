\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Identification of the counterfactual response width $\Delta z^*$ from observed excess mass $B$.} The figure compares the observed taxable income density $h(z)$ (solid blue) with the smooth counterfactual density $g(z)$ interpolated from unaffected neighbors (dashed red) around the kink threshold $z^*$. The excess mass $B$ accumulated above $g(z)$ at $z^*$ equals the missing counterfactual mass over $(z^*, z^* + \Delta z^*]$. Under local uniformity, this area is approximated by the green rectangle $g(z^*) \cdot \Delta z^*$, allowing $\Delta z^*$ to be recovered as $B / g(z^*)$.}}{42}{figure.17}\protected@file@percent }
\newlabel{fig:excess_mass_identification}{{17}{42}{\textbf {Identification of the counterfactual response width $\Delta z^*$ from observed excess mass $B$.} The figure compares the observed taxable income density $h(z)$ (solid blue) with the smooth counterfactual density $g(z)$ interpolated from unaffected neighbors (dashed red) around the kink threshold $z^*$. The excess mass $B$ accumulated above $g(z)$ at $z^*$ equals the missing counterfactual mass over $(z^*, z^* + \Delta z^*]$. Under local uniformity, this area is approximated by the green rectangle $g(z^*) \cdot \Delta z^*$, allowing $\Delta z^*$ to be recovered as $B / g(z^*)$}{figure.17}{}}
