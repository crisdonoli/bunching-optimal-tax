\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Curvature of isoelastic disutility and marginal cost across ETI values.} The left panel plots total disutility $v(z; n, \epsilon ) = \frac  {n}{1+1/\epsilon }(z/n)^{1+1/\epsilon }$ and the right panel plots the corresponding marginal cost $v_z(z; n, \epsilon ) = (z/n)^{1/\epsilon }$ for normalized ability $n = 1$ across different values of the elasticity of taxable income $\epsilon $. Lower values of $\epsilon $ generate steeper curvature around $z = n$, damping behavioral responses to tax rate changes.}}{38}{figure.15}\protected@file@percent }
\newlabel{fig:disutility_curvature}{{15}{38}{\textbf {Curvature of isoelastic disutility and marginal cost across ETI values.} The left panel plots total disutility $v(z; n, \epsilon ) = \frac {n}{1+1/\epsilon }(z/n)^{1+1/\epsilon }$ and the right panel plots the corresponding marginal cost $v_z(z; n, \epsilon ) = (z/n)^{1/\epsilon }$ for normalized ability $n = 1$ across different values of the elasticity of taxable income $\epsilon $. Lower values of $\epsilon $ generate steeper curvature around $z = n$, damping behavioral responses to tax rate changes}{figure.15}{}}
\newlabel{eq:app_eti}{{A.5}{38}{Preferences and the intensive-margin choice}{equation.A.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.1.2}The kink and the marginal buncher.}{38}{subsection.A.2}\protected@file@percent }
\newlabel{eq:app_kink}{{A.6}{39}{The kink and the marginal buncher}{equation.A.6}{}}
\newmarginnote{note.39.1}{{39}{19191627sp}}
\newlabel{eq:app_directional}{{A.7}{39}{The kink and the marginal buncher}{equation.A.7}{}}
\newlabel{eq:app_solution}{{A.8}{39}{The kink and the marginal buncher}{equation.A.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Objective utility and directional marginal utility at a convex kink.} The left panel plots objective utility $U(z;n) = c(z) - v(z;n)$ and the right panel plots marginal utility $U'(z;n)$ across three ability types around the kink threshold $z^* = 1$ ($\tau _0 = 0.10$, $\tau _1 = 0.40$, $\epsilon = 0.5$). Low-ability taxpayers ($n < n_0$) reach an interior optimum strictly below $z^*$, and high-ability taxpayers ($n > n_1$) remain above $z^*$ even after the marginal rate increase. For intermediate types ($n_0 \le n \le n_1$), marginal utility jumps from positive ($U'_-(z^*) > 0$) to negative ($U'_+(z^*) < 0$) at $z^*$, producing a corner optimum at the threshold.}}{40}{figure.16}\protected@file@percent }
\newlabel{fig:directional_utility_kink}{{16}{40}{\textbf {Objective utility and directional marginal utility at a convex kink.} The left panel plots objective utility $U(z;n) = c(z) - v(z;n)$ and the right panel plots marginal utility $U'(z;n)$ across three ability types around the kink threshold $z^* = 1$ ($\tau _0 = 0.10$, $\tau _1 = 0.40$, $\epsilon = 0.5$). Low-ability taxpayers ($n < n_0$) reach an interior optimum strictly below $z^*$, and high-ability taxpayers ($n > n_1$) remain above $z^*$ even after the marginal rate increase. For intermediate types ($n_0 \le n \le n_1$), marginal utility jumps from positive ($U'_-(z^*) > 0$) to negative ($U'_+(z^*) < 0$) at $z^*$, producing a corner optimum at the threshold}{figure.16}{}}
\newlabel{eq:app_nb}{{A.9}{40}{The kink and the marginal buncher}{equation.A.9}{}}
\newlabel{eq:app_buncher}{{A.10}{40}{The kink and the marginal buncher}{equation.A.10}{}}
